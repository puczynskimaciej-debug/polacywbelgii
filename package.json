  "description": "",
  "main": ".eleventy.js",
  "scripts": {
    "dev": "npm run build && npm run local:cms",
    "dev:static": "eleventy --serve",
    "build": "eleventy",
    "test:responsive": "node tests/responsive-audit.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/agent.test.mjs tests/cloudflare.test.mjs tests/discovery.test.mjs tests/gemini.test.mjs",
    "test:legacy": "node --test tests/ads.test.mjs",
    "test:content:http": "node tests/content-http-e2e.mjs",
    "test:content:browser": "node tests/content-browser-e2e.mjs",
    "test:events:http": "node tests/events-http-e2e.mjs",
    "test:events:browser": "node tests/events-cms-browser-e2e.mjs",
    "test:calendar-ads:browser": "node tests/calendar-ads-browser-e2e.mjs",
    "test:ads:ux:browser": "node tests/ads-ux-browser-e2e.mjs",
    "test:ads:carousel:browser": "node tests/ads-carousel-browser-e2e.mjs",
    "test:ads:cms:browser": "node tests/ads-cms-browser-e2e.mjs",
    "test:legal:browser": "node tests/legal-browser-e2e.mjs",
    "content:import-local": "node scripts/local-content-import.mjs",
    "lint": "eslint .",
    "ads:migrate": "node scripts/ads-migrate.js",
    "ads:demo-local": "node scripts/ensure-demo-ads.mjs",
    "cms:migrate": "node scripts/cms-migrate.js",
    "cms:admin": "node scripts/cms-account.js",
    "cms:reset-password": "node scripts/cms-account.js --reset",
    "deploy:check": "node scripts/deployment-check.js",
    "agent:run": "node agent/cli.mjs",
    "agent:discover:article": "node scripts/run-discovery-local.mjs article --free-tier-confirmed",
    "agent:discover:event": "node scripts/run-discovery-local.mjs event --free-tier-confirmed",
    "agent:chat:process-local": "node scripts/run-ai-chat-local.mjs",
    "local:gemini-relay": "node scripts/local-gemini-relay.mjs",
    "test:ai-chat-ads": "node --test tests/ai-chat-ads-targeted.test.mjs",
    "agent:fixture": "node agent/cli.mjs --fixture",
    "agent:dry-run": "node agent/cli.mjs --fixture --dry-run",
    "agent:import-first": "node agent/import-first.mjs",
    "agent:db": "node agent/local-db.mjs",
    "agent:publish-local": "node agent/publish-local.mjs",
    "agent:diagnose": "node scripts/diagnose-publications.mjs",
    "agent:generate": "node agent/generate.mjs",
    "local:d1:setup": "node scripts/local-d1-setup.mjs",
    "local:agent-secret": "node scripts/local-agent-secret.mjs",
    "local:admin": "powershell -NoProfile -File scripts/local-cms-admin.ps1",
    "local:admin:reset": "node scripts/local-cms-admin-reset.mjs",
    "local:cms": "node node_modules/wrangler/bin/wrangler.js pages dev _site --persist-to .local/wrangler --port 8080",
    "local:pages": "node node_modules/wrangler/bin/wrangler.js pages dev _site --persist-to .local/wrangler --port 8791",
    "test:agent": "node --test tests/agent.test.mjs",
    "test:cloudflare": "node --test tests/cloudflare.test.mjs",
    "test:gemini": "node --test tests/gemini.test.mjs",
    "test:editorial:e2e": "node --test tests/editorial-e2e.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@eslint/js": "^10.0.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright-core": "^1.62.0",
    "wrangler": "^4.159.0"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "js-yaml": "^4.3.2",
    "markdown-it": "^14.3.0",
    "pg": "^8.23.0"
  }
