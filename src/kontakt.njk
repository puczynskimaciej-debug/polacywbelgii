---
layout: base.njk
title: Kontakt
description: Skontaktuj się z redakcją Polacy w Belgii.
pageKey: contact
permalink: /kontakt/index.html
---

<header class="page-hero page-hero--compact">
  <div class="container page-hero__inner">
    <span class="eyebrow" data-i18n="contact.eyebrow">Porozmawiajmy</span>
    <h1 data-i18n="nav.contact">Kontakt</h1>
    <p data-i18n="contact.intro">Masz pytanie, temat na artykuł lub ważne ogłoszenie? Napisz do nas.</p>
  </div>
</header>

<section class="section">
  <div class="container contact-layout">
    <aside class="contact-info">
      <span class="eyebrow" data-i18n="contact.editorial">Redakcja</span>
      <h2 data-i18n="contact.heading">{{ site.contact.heading }}</h2>
      <p data-i18n="contact.text">{{ site.contact.description }}</p>
      <div class="contact-detail">
        <span data-i18n="contact.email">E-mail</span>
        <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      </div>
      <div class="contact-detail">
        <span data-i18n="contact.area">Obszar działania</span>
        <strong data-i18n="contact.belgium">{{ site.contact.area }}</strong>
      </div>
    </aside>

    <form class="contact-form" name="kontakt" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="kontakt">
      <p class="honeypot"><label><span data-i18n="form.honeypot">Nie wypełniaj:</span> <input name="bot-field"></label></p>
      <div class="form-field">
        <label for="name" data-i18n="form.name">Imię i nazwisko</label>
        <input id="name" name="name" type="text" autocomplete="name" required>
      </div>
      <div class="form-field">
        <label for="email" data-i18n="form.email">Adres e-mail</label>
        <input id="email" name="email" type="email" autocomplete="email" required>
      </div>
      <div class="form-field">
        <label for="subject" data-i18n="form.subject">Temat</label>
        <select id="subject" name="subject">
          <option data-i18n="form.optionQuestion">Pytanie do redakcji</option>
          <option data-i18n="form.optionArticle">Propozycja artykułu</option>
          <option data-i18n="form.optionNotice">Ogłoszenie</option>
          <option data-i18n="form.optionError">Zgłoszenie błędu</option>
        </select>
      </div>
      <div class="form-field">
        <label for="message" data-i18n="form.message">Wiadomość</label>
        <textarea id="message" name="message" rows="7" required></textarea>
      </div>
      <label class="consent"><input type="checkbox" required> <span data-i18n="form.consent">Zgadzam się na przetwarzanie danych w celu obsługi wiadomości.</span></label>
      <button class="button" type="submit" data-i18n="form.send">Wyślij wiadomość</button>
    </form>
  </div>
</section>
