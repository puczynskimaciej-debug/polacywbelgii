---
layout: base.njk
title: Kontakt
description: Skontaktuj się z redakcją Polacy w Belgii.
pageKey: contact
permalink: /kontakt/index.html
---

<header class="page-hero page-hero--compact">
  <div class="container page-hero__inner">
    <span class="eyebrow" data-i18n="contact.eyebrow">Porozmawiajmy</span>
    <h1 data-i18n="nav.contact">Kontakt</h1>
    <p data-i18n="contact.intro">Masz pytanie, temat na artykuł lub ważne ogłoszenie? Napisz do nas.</p>
  </div>
</header>

<section class="section">
  <div class="container contact-layout">
    <aside class="contact-info">
      <span class="eyebrow" data-i18n="contact.editorial">Redakcja</span>
      <h2 data-i18n="contact.heading">{{ site.contact.heading }}</h2>
      <p data-i18n="contact.text">{{ site.contact.description }}</p>
      <div class="contact-detail">
        <span data-i18n="contact.email">E-mail</span>
        <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      </div>
    </aside>

    <form class="contact-form" name="kontakt" method="POST" action="/api/contact">
      <p class="honeypot"><label><span data-i18n="form.honeypot">Nie wypełniaj:</span> <input name="bot-field"></label></p>
      <div class="form-field">
        <label for="name" data-i18n="form.name">Imię i nazwisko</label>
        <input id="name" name="name" type="text" autocomplete="name" required>
      </div>
      <div class="form-field">
        <label for="email" data-i18n="form.email">Adres e-mail</label>
        <input id="email" name="email" type="email" autocomplete="email" required>
      </div>
      <div class="form-field">
        <label for="subject" data-i18n="form.subject">Temat</label>
        <select id="subject" name="subject">
          <option data-i18n="form.optionQuestion">Pytanie do redakcji</option>
          <option data-i18n="form.optionArticle">Propozycja artykułu</option>
          <option data-i18n="form.optionNotice">Ogłoszenia i wydarzenia</option>
          <option data-i18n="form.optionError">Zgłoszenie błędu</option>
        </select>
      </div>
      <div class="form-field">
        <label for="message" data-i18n="form.message">Wiadomość</label>
        <textarea id="message" name="message" rows="7" required></textarea>
      </div>
      <p data-i18n="form.privacyNotice">Dane z formularza wykorzystujemy, aby odpowiedzieć na wiadomość. Szczegóły znajdziesz w polityce prywatności.</p>
      <label class="consent"><input type="checkbox" name="privacyNoticeAcknowledged" value="yes" required> <span data-i18n="form.privacyAcknowledged">Zapoznałem się z informacją o przetwarzaniu danych.</span></label>
      <a data-privacy-link href="/polityka-prywatnosci/" data-i18n="form.privacyLink">Polityka prywatności</a>
      <button class="button" type="submit" data-i18n="form.send">Wyślij wiadomość</button>
      <p id="contact-result" class="contact-result" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>
<script>
  const form = document.querySelector('.contact-form');
  const notice = document.getElementById('contact-result');
  const copy = {
    pl:{sent:'Wiadomość została wysłana. Dziękujemy za kontakt!',error:'Nie udało się wysłać wiadomości. Spróbuj ponownie później.',invalid:'Sprawdź pola formularza.',limit:'Zbyt wiele wiadomości. Spróbuj później.'},
    nl:{sent:'Bericht verzonden. Bedankt voor uw bericht!',error:'Het bericht kon niet worden verzonden. Probeer het later opnieuw.',invalid:'Controleer de velden van het formulier.',limit:'Te veel berichten. Probeer het later opnieuw.'},
    fr:{sent:'Message envoyé. Merci de nous avoir contactés !',error:'Le message n’a pas pu être envoyé. Réessayez plus tard.',invalid:'Vérifiez les champs du formulaire.',limit:'Trop de messages. Réessayez plus tard.'},
    en:{sent:'Message sent. Thank you for contacting us!',error:'The message could not be sent. Please try again later.',invalid:'Check the form fields.',limit:'Too many messages. Please try again later.'}
  };
  const language = () => copy[sessionStorage.getItem('siteLanguage')] || copy.pl;
  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const button=form.querySelector('[type="submit"]'); button.disabled=true; notice.hidden=true;
    try {
      const response=await fetch(form.action,{method:'POST',body:new URLSearchParams(new FormData(form)),headers:{Accept:'application/json','Content-Type':'application/x-www-form-urlencoded'},credentials:'same-origin'});
      const result=await response.json().catch(()=>({}));
      if (!response.ok || result.sent!==true) throw new Error(result.error==='validation'?language().invalid:result.error==='rateLimit'?language().limit:language().error);
      notice.textContent=language().sent; notice.dataset.state='success'; notice.setAttribute('role','status'); notice.hidden=false; form.reset();
    } catch(error) { notice.textContent=Object.values(language()).includes(error.message)?error.message:language().error; notice.dataset.state='error'; notice.setAttribute('role','alert'); notice.hidden=false; }
    finally { button.disabled=false; }
  });
</script>
