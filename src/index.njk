---
layout: base.njk
title: Strona główna
description: Praktyczne informacje, wiadomości i ogłoszenia dla Polaków mieszkających w Belgii.
pageKey: home
---

<section class="section listing-section" id="listing-top" hidden><div class="container"><h2 data-i18n="ads.top">Polecane firmy</h2><div class="listing-top-grid" data-ad-list="TOP"></div></div></section>

<section class="hero">
  <div class="container hero__content">
    <span class="eyebrow" data-i18n="home.eyebrow">{{ home.hero.eyebrow }}</span>
    <h1 data-i18n="home.title">{{ home.hero.title }}</h1>
    <p data-i18n="home.description">{{ home.hero.description }}</p>
    <div class="hero__actions">
      <a class="button" href="/zamow-ogloszenie/" data-i18n="ads.order">Zamów ogłoszenie</a>
      <a class="button" href="/artykuly/" data-i18n="home.read">Czytaj najnowsze artykuły</a>
      <a class="text-link" href="#ogloszenia"><span data-i18n="home.noticesLink">Zobacz ogłoszenia</span> <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>



<section class="section" aria-labelledby="news-heading">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow" data-i18n="home.worth">Warto wiedzieć</span>
        <h2 id="news-heading" data-i18n="home.latest">Najnowsze informacje</h2>
      </div>
      <a class="text-link" href="/artykuly/"><span data-i18n="home.allArticles">Wszystkie artykuły</span> <span aria-hidden="true">→</span></a>
    </div>
    <div class="news-grid">
      {% for card in home.news %}
      <article class="news-card" data-i18n-group="news.{{ loop.index0 }}">
        <img src="{{ card.image }}" alt="" loading="lazy">
        <div class="news-card__body">
          <span class="tag" data-i18n="news.{{ loop.index0 }}.category">{{ card.category }}</span>
          <h3 data-i18n="news.{{ loop.index0 }}.title">{{ card.title }}</h3>
          <p data-i18n="news.{{ loop.index0 }}.description">{{ card.description }}</p>
          <a class="card-link" href="{{ card.link }}"><span data-i18n="common.more">Dowiedz się więcej</span> <span aria-hidden="true">→</span></a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--tint" id="ogloszenia" aria-labelledby="notices-heading">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow" data-i18n="home.community">Tablica społeczności</span>
        <h2 id="notices-heading" data-i18n="home.notices">Ogłoszenia</h2>
      </div>
      <button class="button" type="button" data-order-open data-i18n="ads.order">Zamów ogłoszenie</button>
    </div>
    <div class="ad-controls"><button type="button" data-ad-prev data-i18n-aria="ads.previous" aria-label="Poprzednie ogłoszenia">←</button><button type="button" data-ad-pause data-i18n="ads.pause">Wstrzymaj</button><button type="button" data-ad-next data-i18n-aria="ads.next" aria-label="Następne ogłoszenia">→</button></div>
    <div class="listing-standard-grid" data-ad-list="STANDARD" tabindex="0"></div>
  </div>
</section>

<section class="cta">
  <div class="container cta__inner">
    <div>
      <span class="eyebrow eyebrow--light" data-i18n="home.question">Testowa sekcja kontaktowa</span>
      <h2 data-i18n="home.help">Przykładowe wezwanie do kontaktu</h2>
      <p data-i18n="home.helpText">To testowy opis miejsca, które później może zachęcać użytkowników do przesyłania pytań i propozycji tematów.</p>
    </div>
    <a class="button button--light" href="/kontakt/" data-i18n="home.contact">Skontaktuj się</a>
  </div>
</section>
