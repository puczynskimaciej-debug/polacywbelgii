---
layout: base.njk
title: Strona główna
description: Praktyczne informacje, wiadomości i ogłoszenia dla Polaków mieszkających w Belgii.
pageKey: home
---

<section class="premium-banner" id="listing-premium" aria-label="Reklama premium" data-i18n-aria="ads.premium" hidden><div class="container" data-ad-list="PREMIUM"></div></section>
<section class="hero">
  <div class="container hero__layout">
  <div class="hero__content">
    <span class="eyebrow" data-i18n="home.eyebrow">{{ home.hero.eyebrow }}</span>
    <h1 data-i18n="home.title">{{ home.hero.title }}</h1>
    <p data-i18n="home.description">{{ home.hero.description }}</p>
    <div class="hero__actions">
      <a class="button" href="/zamow-ogloszenie/" data-i18n="ads.order">Zamów ogłoszenie</a>
      <a class="button" href="/artykuly/" data-i18n="home.read">Czytaj najnowsze artykuły</a>
      <a class="text-link" href="/ogloszenia/"><span data-i18n="home.noticesLink">Zobacz ogłoszenia</span> <span aria-hidden="true">→</span></a>
    </div>
  </div>
  {% include "region-map.njk" %}
  </div>
</section>
<section class="section listing-section" id="listing-top" hidden><div class="container"><h2 data-i18n="ads.top">Polecane firmy</h2><div class="listing-top-grid" data-ad-list="TOP"></div></div></section>



<section class="section home-events" aria-labelledby="home-events-heading">
  <div class="container">
    <div class="section-heading"><div><span class="eyebrow" data-i18n="events.eyebrow">Kalendarz</span><h2 id="home-events-heading" data-i18n="events.homeTitle">Co się dzieje w Belgii?</h2><p data-i18n="events.homeIntro">Odkryj sprawdzone wydarzenia i wybierz dzień w kalendarzu.</p></div><button class="button" type="button" data-event-open data-i18n="events.open">Otwórz kalendarz</button></div>
    <div class="home-events-layout"><div id="home-events" class="home-events-grid" aria-live="polite"></div><div class="home-mini-calendar" aria-label="Kalendarz miesięczny"><div class="home-mini-toolbar"><button type="button" data-mini-month="prev" aria-label="Poprzedni miesiąc">←</button><h3 id="home-mini-title"></h3><button type="button" data-mini-month="next" aria-label="Następny miesiąc">→</button></div><div id="home-mini-grid" class="event-calendar-grid"></div><p id="home-mini-name-days" class="home-mini-name-days" hidden></p><button type="button" class="home-mini-full" data-event-open>Otwórz pełny kalendarz</button></div></div>
  </div>
</section>

<section class="section" aria-labelledby="news-heading">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow" data-i18n="home.worth">Warto wiedzieć</span>
        <h2 id="news-heading" data-i18n="home.latest">Najnowsze informacje</h2>
      </div>
      <a class="text-link" href="/artykuly/"><span data-i18n="home.allArticles">Wszystkie artykuły</span> <span aria-hidden="true">→</span></a>
    </div>
    <div class="news-grid">
      <!-- CMS_LATEST_START -->
      {% for card in home.news %}
      <article class="news-card" data-region="{{ card.region or 'all' }}" data-i18n-group="news.{{ loop.index0 }}">
        <img src="{{ card.image }}" alt="" loading="lazy">
        <div class="news-card__body">
          <span class="tag" data-i18n="news.{{ loop.index0 }}.category">{{ card.category }}</span>
          <h3 data-i18n="news.{{ loop.index0 }}.title">{{ card.title }}</h3>
          <p data-i18n="news.{{ loop.index0 }}.description">{{ card.description }}</p>
          <a class="card-link" href="{{ card.link }}"><span data-i18n="common.more">Dowiedz się więcej</span> <span aria-hidden="true">→</span></a>
        </div>
      </article>
      {% else %}
      <p class="empty-state" data-i18n="articles.emptyText">Pierwsze artykuły są w przygotowaniu. Zajrzyj tu ponownie wkrótce.</p>
      {% endfor %}
      <!-- CMS_LATEST_END -->
    </div>
  </div>
</section>

<section class="section section--tint" id="ogloszenia" aria-labelledby="notices-heading">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow" data-i18n="home.community">Tablica społeczności</span>
        <h2 id="notices-heading" data-i18n="home.notices">Ogłoszenia</h2>
      </div>
      <div class="home-ad-actions"><a class="text-link" href="/ogloszenia/" data-i18n="adsPage.all">Wszystkie ogłoszenia →</a><button class="button" type="button" data-order-open data-i18n="ads.order">Zamów ogłoszenie</button></div>
    </div>
    <div class="listing-standard-grid" data-ad-list="STANDARD" tabindex="0"></div>
    <p class="region-empty" data-region-empty="ads" hidden>Brak aktywnych ogłoszeń. <a href="/ogloszenia/">Zobacz stronę ogłoszeń</a>.</p>
  </div>
</section>

<section class="cta">
  <div class="container cta__inner">
    <div>
      <span class="eyebrow eyebrow--light" data-i18n="home.question">Kontakt</span>
      <h2 data-i18n="home.help">Masz pytanie lub pomysł na temat?</h2>
      <p data-i18n="home.helpText">Napisz do redakcji. Chętnie poznamy sprawy ważne dla Polaków w Belgii.</p>
    </div>
    <a class="button button--light" href="/kontakt/" data-i18n="home.contact">Skontaktuj się</a>
  </div>
</section>
